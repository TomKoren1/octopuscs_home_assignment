#!/bin/bash
# First boot (cloud-init, as root). Log: /var/log/cloud-init-output.log
set -euxo pipefail
export HOME=/root
export DEBIAN_FRONTEND=noninteractive

# Swap: the instance has only 1 GB of RAM
fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

# Ubuntu packages only: mixing them with get.docker.com's breaks the daemon.
# The ECR helper logs Docker in with the instance role (no stored password).
apt-get update -y
apt-get install -y git curl docker.io docker-compose-v2 amazon-ecr-credential-helper
systemctl enable --now docker
docker version --format 'Docker {{.Server.Version}}'
docker compose version

mkdir -p /root/.docker
cat > /root/.docker/config.json <<JSON
{ "credHelpers": { "${ecr_registry}": "ecr-login" } }
JSON

git clone "https://github.com/${github_repo}.git" /opt/octopus-apples
cd /opt/octopus-apples
APP_VERSION=bootstrap ./provision.sh
